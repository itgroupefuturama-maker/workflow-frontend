# URL de l'API principale (backend Node), sans slash final
VITE_API_URL=http://localhost:5050

# URL de l'API "portail", sans slash final
VITE_API_URL_PORTAIL=http://localhost:5001

# Optionnel — décommenter si le backend (VITE_API_URL) tourne sur une autre machine que le
# frontend (ex. via Tailscale) : route les appels axios (auth cookies inclus) via le proxy Vite
# dev pour rester same-origin. Sans ça, les cookies SameSite=Lax d'auth ne sont jamais attachés
# aux requêtes XHR/fetch cross-site (posés au login mais jamais renvoyés ensuite) — voir
# PRODUCTION_CHECKLIST.md, "Sécurité des tokens d'auth", et vite.config.ts.
# VITE_API_PROXY_URL=/api
